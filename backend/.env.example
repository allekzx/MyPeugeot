# Port exposé sur l'hôte pour l'API/dashboard psa_car_controller
PSACC_PORT=5000

# VIN de la voiture à surveiller pour les alertes (mouvement/géofencing).
VIN=

# Port exposé sur l'hôte pour le service alert_watcher (alertes mouvement/géofencing)
ALERT_WATCHER_PORT=5050

# Fréquence de sondage du statut véhicule par alert_watcher, en secondes.
# Lit uniquement le cache de psa_car_controller (from_cache=1) : n'ajoute pas
# d'appel à l'API PSA, donc pas besoin d'un intervalle long pour ça.
ALERT_POLL_SECONDS=180
